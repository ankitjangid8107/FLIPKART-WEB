# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# OpenNext build output is committed so `npx wrangler deploy` works even when
# the Cloudflare project's build command is "None". Only the incremental-cache
# subfolder is regenerated on demand and stays out of git.
.open-next/cache/

# wrangler files
.wrangler
.dev.vars*
!.dev.vars.example
